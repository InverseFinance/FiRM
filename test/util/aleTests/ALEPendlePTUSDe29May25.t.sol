    function _getMaxBorrowAmount(
        uint amountCollat
    ) internal view returns (uint) {
        return
            (amountCollat *
                oracle.viewPrice(address(pendlePT), 0) *
                market.collateralFactorBps()) /
            10_000 /
            1e18;
